# ローカル開発用の環境変数サンプル。コピーして .env.local を作成してください:
#   cp .env.example .env.local
# JWT_SECRET は必ず独自の値に変更すること (例: openssl rand -hex 32)

DATABASE_URL=postgresql://teamd:teamd@localhost:5432/teamd_dev
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# フロントエンド開発用のモック切替。true でAPI呼び出しがモックデータを返す。
# バックエンドのAPIが揃ったら false にして実APIへ切り替える。
NEXT_PUBLIC_USE_MOCK=true
